---
export const prerender = false;

import Layout from "../../../../layouts/BaseLayout.astro";
import { getJobs, type Job } from "../../../../lib/jobs";

// Static paths
export async function getStaticPaths() {
  const jobs = await getJobs();
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

// Load job
const { slug } = Astro.params;
const jobs: Job[] = await getJobs();
const job = jobs.find((j) => j.slug === slug);
if (!job) throw new Error(`Job not found for slug: ${slug}`);

// Get submitted data from URL
const url = new URL(Astro.url.href);
const get = (field: string) => url.searchParams.get(field) ?? "";

const resumeUrl = get("resumeUrl");

console.log("🔍 Previewing application:", {
  firstName: get("firstName"),
  lastName: get("lastName"),
  email: get("email"),
  resumeUrl,
});

const isPdf = resumeUrl.endsWith(".pdf");
---

<Layout
  title={`Review | ${job.title} | GC Careers`}
  description={`Review your application for ${job.title}.`}
  ogTitle={`Review | ${job.title}`}
  ogDescription={`Review your application for ${job.title}.`}
  ogUrl={Astro.url.href}
>
  <section class="pt-32 pb-12 px-4 max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">
      Review Your Application for <span class="text-blue-800">{job.title}</span>
    </h1>

    <ul class="space-y-3 text-lg">
      <li><strong>First Name:</strong> {get("firstName")}</li>
      <li><strong>Last Name:</strong> {get("lastName")}</li>
      <li><strong>Email:</strong> {get("email")}</li>
      <li><strong>Phone:</strong> {get("countryCode")} {get("phone")}</li>
      <li><strong>Gender:</strong> {get("gender")}</li>
      <li><strong>Nationality:</strong> {get("nationality")}</li>
      <li><strong>Date of Birth:</strong> {get("dob")}</li>
      <li><strong>Visa Status:</strong> {get("visa")}</li>
      <li><strong>Experience:</strong> {get("experience")}</li>
      <li><strong>LinkedIn:</strong> {get("linkedin")}</li>
      <li><strong>About:</strong> {get("about")}</li>
    </ul>

    {isPdf && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold mb-3">Resume Preview</h2>
        <div class="border border-gray-300 rounded shadow-md">
          <iframe
            src={resumeUrl}
            class="w-full h-[600px]"
            title="Resume Preview"
          ></iframe>
        </div>
      </div>
    )}

    <!-- Send data to confirmation -->
    <form
      method="POST"
      enctype="multipart/form-data"
      action={`/careers/apply/${slug}/confirmation`}
      class="mt-8"
    >
      <input type="hidden" name="firstName" value={get("firstName")} />
      <input type="hidden" name="lastName" value={get("lastName")} />
      <input type="hidden" name="email" value={get("email")} />
      <input type="hidden" name="phone" value={get("phone")} />
      <input type="hidden" name="countryCode" value={get("countryCode")} />
      <input type="hidden" name="gender" value={get("gender")} />
      <input type="hidden" name="nationality" value={get("nationality")} />
      <input type="hidden" name="dob" value={get("dob")} />
      <input type="hidden" name="visa" value={get("visa")} />
      <input type="hidden" name="experience" value={get("experience")} />
      <input type="hidden" name="linkedin" value={get("linkedin")} />
      <input type="hidden" name="about" value={get("about")} />
      <input type="hidden" name="resumeUrl" value={resumeUrl} />

      <button
        type="submit"
        class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded mt-4"
      >
        Submit Application
      </button>
    </form>
  </section>
</Layout>
---
import Layout from "../../layouts/BaseLayout.astro";
import { getJobs } from "../../lib/jobs";

let jobs = [];
try {
  jobs = await getJobs();
} catch (error) {
  console.warn("Failed to fetch jobs on careers page:", error);
  // Fallback job data for when API is unavailable
  jobs = [
    {
      id: "fallback-1",
      jobId: 1,
      title: "Software Engineer",
      slug: "software-engineer",
      department: "Technology",
      location: "Dubai, UAE",
      employmentType: "Full-time",
      posted: "2025-01-01",
      description: "Join our engineering team to build innovative solutions.",
      responsibilities: [],
      qualifications: []
    },
    {
      id: "fallback-2",
      jobId: 2,
      title: "Business Analyst",
      slug: "business-analyst",
      department: "Business",
      location: "Dubai, UAE",
      employmentType: "Full-time",
      posted: "2025-01-01",
      description: "Analyze business requirements and drive process improvements.",
      responsibilities: [],
      qualifications: []
    }
  ];
}
---

<Layout
  title="Careers | GC International"
  description="Explore open positions at GC International."
  ogTitle="Careers"
  ogDescription="Explore open positions at GC International."
  ogUrl={Astro.url.href}
>
  <section class="pt-32 pb-20 px-6 bg-[#f9f9f9] min-h-screen">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl font-bold mb-10 text-center">Join Our Team</h1>

      <ul class="space-y-8">
        {jobs.map(job => (
          <li class="bg-white border border-gray-200 p-6 rounded-lg shadow-sm">
            <h2 class="text-2xl font-semibold mb-2">{job.title}</h2>
            <p class="text-gray-600 mb-4">{job.location}</p>
            <a
              href={`/careers/${job.slug}`}
              class="inline-block bg-[#0054a4] text-white px-5 py-2 rounded hover:bg-blue-700 transition"
            >
              View Details
            </a>
          </li>
        ))}
      </ul>

      <!-- Disclaimer -->
      <p class="mt-16 text-sm text-gray-500 text-center max-w-3xl mx-auto leading-relaxed">
        GC International is an equal opportunity employer and prohibits discrimination and harassment of any kind based on race, color, sex, religion, national origin, disability, genetic information, pregnancy, or any other protected characteristic as outlined by Article 4 and Article 30 of the UAE Labour Law.
      </p>
    </div>
  </section>
</Layout>

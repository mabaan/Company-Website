---
// src/pages/contact.astro
export const prerender = false;

import Layout from "../layouts/BaseLayout.astro";
import { createContact } from "../lib/airtable";
import { contactAcknowledgement, contactNotification } from "../lib/emailTemplates";
import { sendMail } from "../lib/mailgunClient";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const get = (field: string) => formData.get(field)?.toString() || "";
    const data = {
      Name: get("name"),
      Company: get("company"),
      Email: get("email"),
      Phone: get("phone"),
      Message: get("message"),
    };

    await createContact(data);

    const contactData = {
      name: get("name"),
      company: get("company"),
      email: get("email"),
      phone: get("phone"),
      message: get("message"),
      submittedAt: new Date().toISOString(),
    };

    const contactAck = contactAcknowledgement({ name: contactData.name });
    const contactNotif = contactNotification(contactData);

    try {
      await sendMail({ to: contactData.email, subject: contactAck.subject, html: contactAck.html });
    } catch (err) {
      console.error("Failed to send contact acknowledgement:", err);
    }

    try {
      await sendMail({ to: process.env.MAIL_CONTACT!, subject: contactNotif.subject, html: contactNotif.html });
    } catch (err) {
      console.error("Failed to send contact notification:", err);
    }

    return new Response(null, { status: 200 });
  } catch (err) {
    console.error("Failed to submit contact form:", err);
    return new Response("Submission failed", { status: 500 });
  }
}
---

<Layout
  title="Contact | GC International"
  description="Get in touch with GC International via our contact form."
  ogTitle="Contact | GC International"
  ogDescription="Reach out to GC International"
  ogUrl={Astro.url.href}
>
  <section class="min-h-screen bg-gradient-to-br from-[#f3f6f9] to-[#eaf1fa] pt-32 pb-8 px-2 text-gray-800 flex items-center justify-center">
    <div class="w-full max-w-6xl rounded-3xl shadow-2xl ring-1 ring-[#dde5ee]/60 flex flex-col md:grid md:grid-cols-2 overflow-hidden bg-white/80 backdrop-blur-md">
      <!-- LEFT: Company info (unchanged) -->
      <div class="relative flex flex-col h-full p-6 sm:p-10 bg-gradient-to-b from-[#ffffff99] to-[#f2f7fb]">
        <div class="flex flex-col items-center text-center space-y-10 md:space-y-16 z-20">
          <h1 class="text-3xl md:text-5xl font-extrabold text-[#0054a4] tracking-tight drop-shadow-sm mt-4">
            Contact Us
          </h1>
          <img
            src="https://res.cloudinary.com/dxrwnc5g4/image/upload/v1753901041/gcintle/resume/GC_Logo.png"
            alt="GC International Logo"
            class="w-40 md:w-72 drop-shadow-lg rounded-xl"
          />
          <p class="text-gray-600 text-base md:text-lg max-w-xs md:max-w-sm font-medium">
            We would love to hear from you and welcome your questions, business inquiries, or partnership proposals.<br>
            Please fill out the form below and a member of our team will respond as soon as possible.
          </p>
        </div>
        <div class="flex-1"></div>
        <div class="mt-8 md:mt-10 flex justify-center z-20">
          <div class="text-gray-700 text-center text-sm leading-relaxed space-y-1 w-full max-w-xs">
            <div class="text-[#0054a4] font-bold mb-1">Head Office - Dubai</div>
            <div>GC International FZE</div>
            <div>Dubai Airport Freezone</div>
            <div>Office 520, Building 5EA,</div>
            <div>P.O. Box 293777</div>
            <div>Dubai, United Arab Emirates</div>
            <div class="font-medium mt-1">Tel: <a href="tel:+97142566760" class="hover:underline text-[#0054a4]">+971 4 256 6760</a></div>
            <div class="mt-2">
              <a
                href="https://maps.app.goo.gl/LkACcuJoydHVnRat7"
                target="_blank"
                rel="noopener"
                class="text-[#e41f26] font-semibold underline underline-offset-4 hover:text-[#003968] transition"
              >View on Google Maps</a>
            </div>
          </div>
        </div>
      </div>
      <!-- RIGHT: Contact Form -->
      <div class="flex flex-col justify-center items-center p-0 py-8 md:py-10 bg-[#f2f7fb] md:bg-[#003b71] relative min-h-[500px]">
        <form
          id="contactForm"
          method="POST"
          class="grid gap-7 md:gap-6 bg-white/95 border border-[#e6eaf3] rounded-2xl shadow-lg px-4 py-7 md:px-10 md:py-10 w-full max-w-md"
          novalidate
          autocomplete="off"
        >
          <!-- Name -->
          <div class="grid gap-2">
            <label for="name" class="font-semibold text-[#003b71]">Name</label>
            <input id="name" name="name" type="text" placeholder="Your full name" required class="input-field" />
          </div>
          <!-- Company -->
          <div class="grid gap-2">
            <label for="company" class="font-semibold text-[#003b71]">Company</label>
            <input id="company" name="company" type="text" placeholder="Company name" required class="input-field" />
          </div>
          <!-- Email -->
          <div class="grid gap-2">
            <label for="email" class="font-semibold text-[#003b71]">Email</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" required class="input-field" />
          </div>
          <!-- Phone -->
          <div class="grid gap-2">
            <label for="phone" class="font-semibold text-[#003b71]">Phone</label>
            <input id="phone" name="phone" type="tel" placeholder="+971 50 123 4567" required class="input-field" />
          </div>
          <!-- Message + Counter -->
          <div class="grid gap-2 relative">
            <label for="message" class="font-semibold text-[#003b71]">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Type your message here..."
              required
              maxlength="500"
              class="input-field resize-none"
            ></textarea>
            <div id="charCount" class="absolute bottom-2 right-3 text-xs text-gray-500">0 / 500</div>
          </div>
          <!-- Submit -->
          <button
            type="submit"
            class="bg-[#e41f26] hover:bg-[#ba1721] active:scale-95 text-white px-6 py-3 rounded-xl font-bold tracking-wide transition-all duration-200 shadow-md hover:shadow-lg"
          >
            Send Message
          </button>
        </form>
        <!-- Toast -->
        <div id="toast" class="hidden fixed bottom-5 right-5 bg-green-600 text-white py-2 px-4 rounded shadow-lg text-base z-50"></div>
      </div>
      <!-- Recaptcha Modal -->
      <div id="captchaModal" class="fixed inset-0 flex items-center justify-center bg-black/60 z-50 hidden">
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-2xl w-[92%] max-w-md text-center relative animate-fadeIn">
          <button onclick="closeCaptcha()" class="absolute top-3 right-4 text-gray-400 hover:text-[#e41f26] text-2xl transition" aria-label="Close modal">&times;</button>
          <h2 class="text-xl font-semibold mb-3 text-[#003b71]">Verify you're human</h2>
          <div id="recaptcha-container" class="flex justify-center"></div>
          <button onclick="closeCaptcha()" class="mt-6 text-sm text-gray-500 hover:text-gray-700 underline">
            Cancel
          </button>
        </div>
      </div>
      <!-- Loader Overlay -->
      <div id="contactLoader" class="fixed inset-0 flex items-center justify-center bg-black/40 z-[60] hidden">
        <div class="bg-white rounded-2xl px-8 py-7 shadow-2xl flex flex-col items-center gap-4 animate-fadeIn">
          <svg class="animate-spin h-8 w-8 text-[#e41f26]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-30" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
          <span class="text-[#003b71] font-semibold text-lg mt-2">Sending...</span>
        </div>
      </div>
      <style>
        .input-field {
          @apply w-full px-4 py-2 border border-gray-300 rounded-lg font-medium text-gray-900
            focus:outline-none focus:ring-2 focus:ring-[#e41f26] focus:border-[#e41f26] transition
            placeholder-gray-400 bg-white/70;
          box-shadow: 0 1px 2px 0 #b6c4d833;
        }
        .input-field:focus {
          box-shadow: 0 2px 8px 0 #e41f2610, 0 1.5px 2px 0 #b6c4d855;
          background: #f8fcff;
        }
        @media (max-width: 768px) {
          .input-field {
            font-size: 1rem;
          }
        }
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(30px);}
          to { opacity: 1; transform: translateY(0);}
        }
        .animate-fadeIn { animation: fadeIn 0.25s both; }
      </style>
    </div>
  </section>

  <!-- reCAPTCHA script -->
  <script src="https://www.google.com/recaptcha/api.js?onload=renderCaptcha&render=explicit" async defer></script>

  <script>
    let captchaRendered = false, lastFocused: HTMLElement | null = null;

    window.renderCaptcha = function () {
      if (!captchaRendered) {
        grecaptcha.render("recaptcha-container", {
          sitekey: import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY,
          callback: window.onCaptchaSuccess,
        });
        captchaRendered = true;
      }
    };

    window.openCaptcha = function () {
      const modal = document.getElementById("captchaModal");
      if (modal) {
        lastFocused = document.activeElement as HTMLElement | null;
        modal.classList.remove("hidden");
        const closeBtn = modal.querySelector("button[aria-label='Close modal']");
        if (closeBtn && closeBtn instanceof HTMLElement) {
          closeBtn.focus();
        } else {
          modal.focus();
        }
      }
      setTimeout(window.renderCaptcha, 150);
      document.body.style.overflow = "hidden";
    };

    window.closeCaptcha = function () {
      const modal = document.getElementById("captchaModal");
      if (modal) modal.classList.add("hidden");
      if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
      document.body.style.overflow = "";
    };

    window.onCaptchaSuccess = function () {
      window.closeCaptcha();

      const loader = document.getElementById("contactLoader");
      if (loader) loader.classList.remove("hidden");

      const form = document.getElementById("contactForm") as HTMLFormElement | null;
      const toast = document.getElementById("toast");
      const charCount = document.getElementById("charCount");
      if (form) {
        const formData = new FormData(form);
        fetch(form.action || window.location.pathname, {
          method: "POST",
          body: formData,
        }).then(function(res) {
          if (toast) {
            if (res.ok) {
              toast.textContent = "Message sent successfully!";
              toast.classList.remove("hidden");
              setTimeout(function() { toast.classList.add("hidden"); }, 3000);
              form.reset();
              if (charCount) charCount.textContent = "0 / 500";
            } else {
              toast.textContent = "Failed to send message.";
              toast.classList.remove("hidden");
              setTimeout(function() { toast.classList.add("hidden"); }, 3000);
            }
          }
          if (loader) loader.classList.add("hidden");
        }).catch(function() {
          if (toast) {
            toast.textContent = "Failed to send message.";
            toast.classList.remove("hidden");
            setTimeout(function() { toast.classList.add("hidden"); }, 3000);
          }
          if (loader) loader.classList.add("hidden");
        });
      } else {
        if (loader) loader.classList.add("hidden");
      }
    };

    // Char counter
    const msgField = document.getElementById("message");
    const charCount = document.getElementById("charCount");
    if (msgField && charCount) {
      msgField.addEventListener("input", function () {
        charCount.textContent = (msgField as HTMLTextAreaElement).value.length + " / 500";
      });
    }

    // Intercept submit: show recaptcha modal if valid
    const form = document.getElementById("contactForm");
    if (form) {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        let valid = true;
        form.querySelectorAll("[required]").forEach(function(field) {
          if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) return;
          if (!field.value.trim()) {
            field.classList.add("border-red-500", "ring-red-500", "ring-1");
            valid = false;
          } else {
            field.classList.remove("border-red-500", "ring-red-500", "ring-1");
          }
        });
        if (valid) window.openCaptcha();
      });
    }

    // Allow Escape key to close modal (but does NOT trigger form submit)
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") window.closeCaptcha();
    });
  </script>
</Layout>

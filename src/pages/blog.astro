---
import Layout from "src/layouts/BaseLayout.astro";
import BlogCard from "src/components/BlogCard.tsx"; 
import BlogNavbar from "src/components/BlogNavbar.tsx";
import { client } from "src/lib/sanityClient.ts";
import { getPostDescription } from "src/lib/getDescription.ts";

// Fetch all posts
const posts = await client.fetch(`
  *[_type == "post" && defined(publishedAt)] | order(publishedAt desc) {
    title,
    slug,
    publishedAt,
    "imageUrl": mainImage.asset->url,
    "author": author->name,
    categories[]->{ title, slug },
    body
  }
`);

// Fetch all categories for nav
const categories = await client.fetch(`*[_type == "category"]{ title, slug }`);

// SEO description using first post body
const description = posts.length > 0 ? getPostDescription(posts[0].body) : "";
---

<Layout title="Blog | GC International" description={description}>
    <!-- Spacer between main navbar and BlogNavbar -->
<div class="h-8 md:h-12" aria-hidden="true"></div>

  <BlogNavbar client:load categories={categories} />

  <section class="w-full max-w-6xl mx-auto px-4 py-12">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500">No blog posts found.</p>
    )}
  </section>
</Layout>

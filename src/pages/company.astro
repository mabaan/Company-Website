---
import Layout from "../layouts/BaseLayout.astro";
import ImageCarousel from "../components/ImageCarousel";
import WhoWeAre from "../components/WhoWeAre";
import WhatWeDo from "../components/WhatWeDo";
import PartnersSection from "../components/PartnersSection";
import BecomePartnerSection from "../components/BecomePartnerSection";
import JoinUsSection from "../components/JoinUsSection";
---

<Layout
  title="Company"
  description="Learn about GC International and our global partnerships."
  ogTitle="Company"
  ogDescription="Learn about GC International and our global partnerships."
  ogUrl={Astro.url.href}
>
  <div class="pt-32 bg-[#f5f7fa]">
    <!-- Hero / Image Carousel -->
    <ImageCarousel client:load />

    <!-- Who We Are Section -->
    <WhoWeAre client:visible />

    <!-- What We Do Section -->
    <WhatWeDo client:visible />

    <!-- Partners Section -->
    <PartnersSection client:visible />

    <!-- Become a Partner Section -->
    <BecomePartnerSection client:visible />

    <!-- Join Us Section -->
    <JoinUsSection client:visible />
  </div>
</Layout>

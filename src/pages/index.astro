---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import WhyChooseUs from '../components/WhyChooseUs';
import Stats from '../components/Stats';
import CTASection from '../components/CTASection';

// Page-specific SEO
const pageTitle = "GC International | Valve & Actuator Solutions";
const pageDescription =
  "Premium valve and actuator solutions supplier based in Dubai Airport Free Zone. Authorized distributors of the world’s leading brands.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogUrl={Astro.url.href}
>
  <main id="page-content" class="main-content">
    <Hero client:load />
    <WhyChooseUs />
    <Stats client:load />
    <CTASection client:load />
  </main>
</BaseLayout>

---
// src/pages/blog/[slug].astro
export const prerender = false;

import Layout from "../../layouts/BaseLayout.astro";
import { client } from "../../lib/sanityClient";
import { PortableText } from "@portabletext/react";
import { getPostDescription } from "../../lib/getDescription";

const { slug } = Astro.params;

// Fetch the single post by slug
const post = await client.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    publishedAt,
    "imageUrl": mainImage.asset->url,
    "authors": authors[]->{
      name,
      "image": image.asset->url
    },
    body
  }`,
  { slug }
);

if (!post) throw new Error("Post not found");

const authors = Array.isArray(post.authors) ? post.authors : [];
const description = getPostDescription(post.body);

function formatAuthors(authors: { name: string }[]) {
  if (!authors.length) return "The Intern";
  const names = authors.map((a) => a.name);
  if (names.length === 1) return names[0];
  if (names.length === 2) return `${names[0]} and ${names[1]}`;
  if (names.length === 3) return `${names[0]}, ${names[1]}, and ${names[2]}`;
  return `${names[0]}, ${names[1]}, and ${names.length - 2} others`;
}
---

<Layout
  title={`${post.title} | GC Blog`}
  description={description}
  ogImage={post.imageUrl || 'https://res.cloudinary.com/dxrwnc5g4/image/upload/v1753901040/gcintle/resume/logo.png'}
>
  <!-- Top Spacer -->
  <div class="h-16 sm:h-28" aria-hidden="true"></div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-14 rounded-2xl bg-white/90 shadow-xl border border-[#e3e8ee] mt-8 mb-8 sm:mt-16 sm:mb-16">
    {post.imageUrl && (
      <div class="w-full rounded-2xl mb-10 overflow-hidden shadow">
        <img
          src={post.imageUrl}
          alt={post.title}
          class="w-full object-cover h-44 md:h-72"
          width="1280"
          height="480"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <h1 class="text-4xl font-bold mb-1 text-[#003b71] leading-tight mt-4">{post.title}</h1>

    <div class="flex items-center gap-3 text-sm text-gray-600 mb-4">
      <span>
        by <span class="font-semibold text-[#e41f26]">{formatAuthors(authors)}</span>
      </span>
      <span>•</span>
      <span>
        {post.publishedAt &&
          new Date(post.publishedAt).toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
      </span>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <div class="flex -space-x-3">
        {authors.length > 0 ? (
          authors.slice(0, 3).map((author: { name: string; image?: string }, i: number) =>
            author.image ? (
              <img
                src={author.image}
                alt={author.name}
                class="w-9 h-9 rounded-full border-2 border-white object-cover"
              />
            ) : (
              <div
                class="w-9 h-9 rounded-full bg-gray-300 text-white text-sm font-bold flex items-center justify-center border-2 border-white"
              >
                {author.name.charAt(0).toUpperCase()}
              </div>
            )
          )
        ) : (
          <div class="w-9 h-9 rounded-full bg-gray-300 text-white text-sm font-bold flex items-center justify-center border-2 border-white">
            I
          </div>
        )}
        {authors.length > 3 && (
          <div class="w-9 h-9 rounded-full bg-gray-700 text-white text-sm font-medium flex items-center justify-center border-2 border-white">
            +{authors.length - 3}
          </div>
        )}
      </div>
    </div>

    <hr class="border-t border-[#e3e8ee] mb-8" />

    <div class="prose prose-lg max-w-none prose-p:mb-6 prose-h2:mb-5 prose-h2:font-bold prose-h2:text-2xl">
      <PortableText value={post.body} />
    </div>



    <div class="mt-12">
      <a
        href="/blog"
        class="inline-block px-6 py-2 bg-[#0054a4] text-white rounded-full hover:bg-[#003e84] font-medium text-base shadow transition"
      >
        Back to All Blogs
      </a>
    </div>
  </article>

  <!-- Bottom Spacer -->
  <div class="h-16 sm:h-28" aria-hidden="true"></div>
</Layout>

{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://gcintle.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.gcintle.com"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ]
}

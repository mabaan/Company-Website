---
export const prerender = false;
export const server = true;

import Layout from "../../../../layouts/BaseLayout.astro";
import ProgressSteps from "../../../../components/ProgressSteps.tsx";
import { getJobs } from "../../../../lib/jobs";
import { uploadResumeToCloudinary } from "../../../../lib/uploadResumeToCloudinary";
import { base, APPLICATIONS_TABLE } from "../../../../lib/airtable";
import { applicantConfirmation, hrNotification } from "../../../../lib/emailTemplates";
import { sendMail } from "../../../../lib/mailgunClient";

// Load job by slug
console.log('--- Handling job application confirmation ---');
const jobs = await getJobs();
const { slug } = Astro.params;
const job = jobs.find((j) => j.slug === slug);
if (!job) throw new Error("Job not found");

console.log("✅ Job loaded:", job);

// Parse formData
let formData: FormData;
try {
  formData = await Astro.request.formData();
} catch {
  console.warn("⚠️ FormData fetch failed");
  formData = new FormData();
}

const get = (field: string) => formData.get(field)?.toString().trim() ?? "";

const dob = get("dob");
const gender = get("gender");
const experience = parseFloat(get("experience"));

if (!dob || isNaN(Date.parse(dob))) throw new Error("❌ Invalid DOB");
if (!["Male", "Female"].includes(gender)) throw new Error("❌ Invalid gender");
if (isNaN(experience)) throw new Error("❌ Invalid experience");

let resumeFile = formData.get("resume") as File | null;
let resumeUrl = get("resumeUrl");
const resumeBase64 = get("resumeBase64");
const resumeMime = get("resumeMime");
const resumeName = get("resumeName") || "resume.pdf";

if (!resumeFile && resumeBase64) {
  const buf = Buffer.from(resumeBase64, "base64");
  resumeFile = new File([buf], resumeName, { type: resumeMime || "application/pdf" });
}

console.log("📥 Form parsed. Resume file present:", !!resumeFile);

console.log("--- Creating Airtable application record ---");
// Step 1: Create Airtable record first
const [newRecord] = await base(APPLICATIONS_TABLE).create([
  {
    fields: {
      "First Name": get("firstName"),
      "Last Name": get("lastName"),
      Email: get("email"),
      "Country Code": get("countryCode"),
      "Phone Number": get("phone"),
      Nationality: get("nationality"),
      Gender: gender,
      DOB: dob,
      "Visa Status": get("visa"),
      Experience: experience,
      LinkedIn: get("linkedin"),
      About: get("about"),
      "Job Applied For": [job.id], // ✅ Correct Airtable record ID
      // "Submitted at": new Date().toISOString(), // Optional: Computed field
    },
  },
]);

const applicationId = newRecord.fields["Application ID"];
const applicationRecordId = newRecord.id;

if (!applicationId) {
  console.error("❌ Missing Application ID from Airtable");
  throw new Error("Application ID missing");
}

console.log("✅ Created application record:", {
  id: applicationRecordId,
  appId: applicationId,
});

// Step 2: Upload resume and PATCH Airtable
if (!resumeUrl && resumeFile && resumeFile.size > 0) {
  const jobId = job.jobId;
  if (!jobId) {
    console.error("❌ Job ID is missing from job record");
    throw new Error("Job ID required for Cloudinary upload");
  }

  console.log("📤 Uploading resume to Cloudinary...");
  resumeUrl = await uploadResumeToCloudinary(
    resumeFile,
    jobId,
    typeof applicationId === "string" || typeof applicationId === "number"
      ? applicationId
      : applicationId?.toString?.() ?? ""
  );

  console.log("✅ Resume uploaded:", resumeUrl);
}

// Step 3: Prepare and send confirmation emails
const applicantPayload = applicantConfirmation({
  firstName: get("firstName"),
  role: job.title,
});

const hrPayload = hrNotification({
  applicationId: typeof applicationId === "string" || typeof applicationId === "number"
    ? applicationId
    : applicationId?.toString?.() ?? "",
  jobId: job.jobId,
  firstName: get("firstName"),
  lastName: get("lastName"),
  email: get("email"),
  countryCode: get("countryCode"),
  phone: get("phone"),
  nationality: get("nationality"),
  gender,
  dob,
  visa: get("visa"),
  experience,
  linkedin: get("linkedin"),
  about: get("about"),
  resumeUrl,
  role: job.title,
});

// Email the applicant a confirmation
try {
  console.log("📧 Sending confirmation to applicant");
  await sendMail({
    to: formData.get("email") as string,
    subject: applicantPayload.subject,
    html: applicantPayload.html,
  });
  console.log("✅ Applicant email sent");
} catch (err) {
  console.error("Failed to send applicant email:", err);
}

// Notify HR and BCC the contact address
try {
  console.log("📧 Notifying HR at", process.env.MAIL_HR);
  await sendMail({
    to: process.env.MAIL_HR!,
    bcc: `${process.env.MAIL_CONTACT!},${process.env.MAIL_MANAGEMENT!}`,
    subject: hrPayload.subject,
    html: hrPayload.html,
  });
  console.log("✅ HR notification sent");
} catch (err) {
  console.error("Failed to send HR notification:", err);
}

// You can add a redirect or render confirmation here
---

<Layout
  title={`Application Submitted | ${job.title}`}
  description={`Your application for ${job.title} has been submitted.`}
  ogTitle={`Application Submitted | ${job.title}`}
  ogDescription={`Thank you for applying to GC International.`}
  ogUrl={Astro.url.href}
>
  <section class="pt-32 pb-12 px-4 min-h-[70vh] flex flex-col items-center">
    {/* Progress bar directly under Navbar */}
    <div class="w-full max-w-4xl -mt-8 pt-8">
      <ProgressSteps currentStep={3} client:load />
    </div>
    {/* Confirmation card centered below */}
    <div class="flex-1 flex flex-col items-center justify-center w-full">
      <div class="w-full max-w-2xl mt-10 bg-white shadow-xl rounded-2xl px-6 sm:px-10 py-10 text-center border border-gray-100">
        <img
            src="https://res.cloudinary.com/dxrwnc5g4/image/upload/v1754148641/gcintle/resume/submitted.svg"
            alt="Submitted"
            class="mx-auto mb-5 h-14 w-14 object-contain"
          />
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#003b71] mb-4">Application Submitted</h1>
        <p class="text-lg mb-2">
          Thank you for applying to <span class="font-semibold text-[#0054a4]">{job.title}</span> at GC International.
        </p>
        <p class="text-gray-600 mb-8">
        We have sent you a confirmation email.<br/>
        Our team will review your application and get back to you soon.
        </p>
        <a
          href="/careers"
          class="inline-block bg-[#0054a4] hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold text-base transition-colors"
        >
          View Other Openings
        </a>
      </div>
    </div>
  </section>
</Layout>


